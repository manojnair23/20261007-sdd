{
  "name": "agentclinic",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run typecheck && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "validate": "npm run typecheck && npm test",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@picocss/pico": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
